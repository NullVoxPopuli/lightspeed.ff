{
  "manifest_version": 3,
  "name": "lightspeed.ff",
  "version": "0.0.1",
  "description": "Keyboard access to every interactable element on a page",
  "icons": {
    "128": "icons/falling-star-icon.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "nvp-permissionless@lightspeed.ff"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/index.js"],
      "run_at": "document_start"
    }
  ]
}
